# Copy to launch.env. Addresses only: never put a private key in this file.

# Printed by: node tools/wallet.js keeper-secret patrick734/xStockfi
KEEPER_ADDRESS=0x...

# Leave empty: the token launches on Pons after the deploy, then ./set-token.sh plugs it in.
XSF_TOKEN_ADDRESS=

# Optional: your own Robinhood Chain RPC if the public one keeps dropping connections.
# ROBINHOOD_RPC_URL=https://...
